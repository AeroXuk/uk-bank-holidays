-- UK bank holidays: create table ({{ d.name }})
-- Generated by uk_bank_holidays. Safe to re-run: an existing table (and its data) is left untouched.
{% if schema and d.name == "mssql" and schema != "dbo" %}

IF SCHEMA_ID(N'{{ schema }}') IS NULL EXEC(N'CREATE SCHEMA {{ d.quote(schema) }}');
{{ d.batch_separator }}
{% elif schema and d.name != "mssql" %}

CREATE SCHEMA IF NOT EXISTS {{ d.quote(schema) }};
{% endif %}

{% if d.name == "mssql" %}
IF OBJECT_ID(N'{{ table_ref }}', N'U') IS NULL
BEGIN
    CREATE TABLE {{ table_ref }} (
        {{ column_lines | join(",\n        ") }}
    );
END;
{{ d.batch_separator }}
{% else %}
CREATE TABLE IF NOT EXISTS {{ table_ref }} (
    {{ column_lines | join(",\n    ") }}
);
{% endif %}
