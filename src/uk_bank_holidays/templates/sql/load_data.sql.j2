-- UK bank holidays: load data ({{ d.name }})
-- Generated by uk_bank_holidays for {{ start_year }} to {{ end_year }} ({{ row_count }} rows).
-- Safe to re-run: rows are staged and upserted on ({{ key_columns }}), so missing rows are
-- added, changed rows are updated and nothing is duplicated.
{% if prune %}
-- Prune is ON: rows in this date range that are not in this script are deleted.
{% else %}
-- Rows that are not in this script are never deleted (generate with --prune to change that).
{% endif %}

{% if d.name == "mssql" %}
IF OBJECT_ID(N'tempdb..#{{ stage_name }}') IS NOT NULL DROP TABLE {{ stage_ref }};
SELECT TOP 0 {{ cols }} INTO {{ stage_ref }} FROM {{ table_ref }};
{% elif d.name == "snowflake" %}
CREATE OR REPLACE TEMPORARY TABLE {{ stage_ref }} LIKE {{ table_ref }};
{% elif d.name == "postgres" %}
DROP TABLE IF EXISTS {{ stage_ref }};
CREATE TEMPORARY TABLE {{ stage_create }} (LIKE {{ table_ref }});
{% elif d.name == "mysql" %}
DROP TEMPORARY TABLE IF EXISTS {{ stage_ref }};
CREATE TEMPORARY TABLE {{ stage_ref }} LIKE {{ table_ref }};
{% elif d.name == "bigquery" %}
CREATE OR REPLACE TEMP TABLE {{ stage_ref }} AS SELECT * FROM {{ table_ref }} WHERE FALSE;
{% elif d.name == "sqlite" %}
DROP TABLE IF EXISTS {{ stage_ref }};
CREATE TEMPORARY TABLE {{ stage_create }} AS SELECT * FROM {{ table_ref }} WHERE 0;
{% endif %}
{% if d.batch_separator %}
{{ d.batch_separator }}
{% endif %}

{% for batch in batches %}
INSERT INTO {{ stage_ref }} ({{ cols }})
VALUES
{{ batch | join(",\n") | indent(4, first=True) }};
{% endfor %}
{% if d.batch_separator %}
{{ d.batch_separator }}
{% endif %}

{% if d.name == "mssql" %}
MERGE INTO {{ table_ref }} AS tgt
USING {{ stage_ref }} AS src
    ON {{ merge_on }}
WHEN MATCHED THEN UPDATE SET
    {{ update_pairs | join(",\n    ") }}
WHEN NOT MATCHED BY TARGET THEN INSERT ({{ cols }})
    VALUES ({{ insert_values }});
{% elif d.name in ("snowflake", "bigquery") %}
MERGE INTO {{ table_ref }} AS tgt
USING {{ stage_ref }} AS src
    ON {{ merge_on }}
WHEN MATCHED THEN UPDATE SET
    {{ update_pairs | join(",\n    ") }}
WHEN NOT MATCHED THEN INSERT ({{ cols }})
    VALUES ({{ insert_values }});
{% elif d.name in ("postgres", "sqlite") %}
INSERT INTO {{ table_ref }} ({{ cols }})
SELECT {{ cols }} FROM {{ stage_ref }}{{ " WHERE TRUE" if d.name == "sqlite" }}
ON CONFLICT ({{ key_columns }}) DO UPDATE SET
    {{ excluded_pairs | join(",\n    ") }};
{% elif d.name == "mysql" %}
INSERT INTO {{ table_ref }} ({{ cols }})
SELECT {{ cols }} FROM {{ stage_ref }}
ON DUPLICATE KEY UPDATE
    {{ values_pairs | join(",\n    ") }};
{% endif %}
{% if prune %}

DELETE FROM {{ table_ref }}
WHERE {{ d.quote("holiday_date") }} BETWEEN {{ start_date }} AND {{ end_date }}
  AND NOT EXISTS (
    SELECT 1 FROM {{ stage_ref }} AS src
    WHERE {{ merge_on_delete }}
  );
{% endif %}
{% if d.batch_separator %}
{{ d.batch_separator }}
{% endif %}

{% if d.name == "mssql" %}
DROP TABLE {{ stage_ref }};
{% elif d.name == "mysql" %}
DROP TEMPORARY TABLE {{ stage_ref }};
{% else %}
DROP TABLE {{ stage_ref }};
{% endif %}
